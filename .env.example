# QForge 环境变量示例
# 复制为 .env 后按需修改；.env 已被 .gitignore 排除，不得入库。

# ---- 运行环境 ----
QFORGE_ENVIRONMENT=dev
QFORGE_LOG_LEVEL=INFO

# ---- 存储根目录（SPEC 14.2）----
# 留空则使用仓库内 storage/
# QFORGE_STORAGE_ROOT=D:/QForge/storage

# ---- 数据库（SPEC 14.1）----
# 留空则使用 storage/qforge.db（SQLite，阶段 0 默认）
# 阶段 1 切换 PostgreSQL 示例：
# QFORGE_DATABASE_URL=postgresql+psycopg://qforge:qforge@127.0.0.1:5432/qforge
QFORGE_DATABASE_ECHO=false
QFORGE_AUTO_CREATE_SCHEMA=true

# ---- 任务队列（SPEC 3 / 13）----
# 阶段 0：本机无 Redis，保持 eager；阶段 1 起置 false 并启动 Redis
QFORGE_CELERY_TASK_ALWAYS_EAGER=true
QFORGE_CELERY_BROKER_URL=redis://127.0.0.1:6379/0
QFORGE_CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ---- 资源限制（SPEC 15；阶段 1 起强制执行）----
QFORGE_MAX_UPLOAD_MB=2048
QFORGE_MAX_ZIP_UNCOMPRESSED_MB=8192
QFORGE_MAX_ZIP_ENTRIES=20000
QFORGE_MAX_ZIP_DEPTH=8
QFORGE_TASK_TIMEOUT_SECONDS=3600
QFORGE_MAX_CONCURRENT_TASKS=1
