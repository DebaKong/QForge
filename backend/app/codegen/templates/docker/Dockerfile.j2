# 生成文件：{{ architecture }} {{ precision }} 推理工程运行镜像（SPEC 12.2）
#
# 说明（务必先读）：
#   1. 基础镜像 tag 属版本敏感项（SPEC 4.1），必须与构建 Engine 时的
#      TensorRT / CUDA 版本一致，否则 Engine 反序列化会失败（Engine 与构建环境强绑定）。
#      本工程 Engine 构建环境：TensorRT {{ backend.version }} / CUDA {{ backend.cuda_version }}。
#   2. 因此这里用 ARG 暴露基础镜像，**首次构建前请确认 tag 可用**，不要直接依赖默认值。
#   3. 镜像构建属 SPEC 2.1 的「可选生成镜像」，需要 Docker daemon 可用。

ARG BASE_IMAGE=nvcr.io/nvidia/tensorrt:REPLACE_WITH_CONFIRMED_TAG
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/qforge

ENV QFORGE_TASK_ID={{ task_id }} \
    QFORGE_PRECISION={{ precision }}

# 运行期只需要：可执行文件、TensorRT/CUDA 运行库（由基础镜像提供）、Engine 与样例输入
COPY source/ /opt/qforge/source/
COPY model/{{ engine_filename }} /opt/qforge/model/{{ engine_filename }}
COPY config/ /opt/qforge/config/
COPY test/ /opt/qforge/test/
COPY report/ /opt/qforge/report/

# 以非 root 运行（SPEC 12.1：默认最小权限）
RUN useradd --create-home --shell /bin/bash qforge \
    && chown -R qforge:qforge /opt/qforge
USER qforge

# 默认做一次真实推理，验证镜像内 Engine 可加载（加载失败即容器失败退出）
ENTRYPOINT ["/opt/qforge/source/build/qforge_detector"]
CMD ["--engine", "/opt/qforge/model/{{ engine_filename }}", \
     "--image", "/opt/qforge/test/sample.ppm", \
     "--output", "/opt/qforge/report/image_result.json", \
     "--iterations", "3"]
