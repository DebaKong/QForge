@echo off
rem QForge real-time inference launcher (camera + push) - generated by QForge
rem Keep this file ASCII-only with CRLF line endings (cmd.exe garbles UTF-8 text).
rem See README.md for details.
setlocal
cd /d "%~dp0"

set "BIN=bin\qforge_detector.exe"
set "ENGINE=model\model.engine"
set "PUSH_URL=%~1"
set "PUSH_INTERVAL=%~2"

if "%PUSH_URL%"=="" set "PUSH_URL=http://127.0.0.1:9000/events"
if "%PUSH_INTERVAL%"=="" set "PUSH_INTERVAL=1"

if not exist "%BIN%" goto no_bin
if not exist "%ENGINE%" goto no_engine

echo ============================================================
echo  QForge real-time camera inference  ({{ model.architecture }} / {{ precision_label }})
echo ============================================================
echo.
echo  camera : 0 (default; change it in this file)
echo  engine : %ENGINE%
echo  push   : %PUSH_URL   (every %PUSH_INTERVAL% frame^(s^))
echo.
echo  Press Ctrl+C to stop. Add --display below to see a preview window.
echo.

"%BIN%" --engine "%ENGINE%" --camera 0 --push "%PUSH_URL%" --push-interval %PUSH_INTERVAL% --stats-every 30
set "CODE=%ERRORLEVEL%"
echo.
if not "%CODE%"=="0" goto failed
echo  Stopped.
pause
exit /b 0

:failed
echo  [FAILED] exit code %CODE%
echo  Common causes:
echo    1^) This package was built WITHOUT OpenCV - rebuild with -DQFORGE_WITH_OPENCV=ON
echo    2^) Camera index 0 is not your camera, or it is in use by another program
echo    3^) TensorRT / CUDA runtime DLLs not found - add TensorRT's bin folder to PATH
echo  See README.md for details.
echo.
pause
exit /b %CODE%

:no_bin
echo  [FAILED] bin\qforge_detector.exe not found. See README.md.
pause
exit /b 1

:no_engine
echo  [FAILED] model\model.engine not found. See README.md.
pause
exit /b 1
