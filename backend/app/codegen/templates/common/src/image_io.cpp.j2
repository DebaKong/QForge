// 生成文件：图像与张量文件读写实现
#include "qforge/image_io.h"

#include <cctype>
#include <cstdint>
#include <fstream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

namespace qforge {
namespace {

/// 跳过 PPM 头部的空白与注释（以 # 开头到行尾）
void skip_whitespace_and_comments(std::istream& stream) {
  while (stream.good()) {
    const int next = stream.peek();
    if (next == '#') {
      std::string line;
      std::getline(stream, line);
      continue;
    }
    if (std::isspace(next) != 0) {
      stream.get();
      continue;
    }
    break;
  }
}

int read_int(std::istream& stream, const char* field) {
  skip_whitespace_and_comments(stream);
  int value = 0;
  if (!(stream >> value)) {
    throw std::runtime_error(std::string("PPM 解析失败：无法读取 ") + field);
  }
  return value;
}

}  // namespace

Image load_ppm(const std::string& path) {
  std::ifstream stream(path, std::ios::binary);
  if (!stream) {
    throw std::runtime_error("无法打开图像文件: " + path);
  }

  std::string magic;
  stream >> magic;
  if (magic != "P6") {
    throw std::runtime_error("仅支持 P6 二进制 PPM 图像，收到: " + magic);
  }

  Image image;
  image.width = read_int(stream, "width");
  image.height = read_int(stream, "height");
  const int max_value = read_int(stream, "maxval");
  if (image.width <= 0 || image.height <= 0) {
    throw std::runtime_error("PPM 尺寸非法");
  }
  if (max_value != 255) {
    throw std::runtime_error("PPM maxval 必须为 255");
  }

  stream.get();  // 分隔用单字节空白
  image.channels = 3;
  image.pixels.resize(static_cast<std::size_t>(image.width) * image.height * 3);
  stream.read(reinterpret_cast<char*>(image.pixels.data()),
              static_cast<std::streamsize>(image.pixels.size()));
  if (stream.gcount() != static_cast<std::streamsize>(image.pixels.size())) {
    throw std::runtime_error("PPM 像素数据不完整");
  }
  return image;
}

std::vector<float> load_raw_tensor(const std::string& path, std::size_t expected_count) {
  std::ifstream stream(path, std::ios::binary | std::ios::ate);
  if (!stream) {
    throw std::runtime_error("无法打开张量文件: " + path);
  }
  const std::streamsize bytes = stream.tellg();
  stream.seekg(0, std::ios::beg);
  if (bytes % static_cast<std::streamsize>(sizeof(float)) != 0) {
    throw std::runtime_error("张量文件大小不是 float32 的整数倍: " + path);
  }
  std::vector<float> data(static_cast<std::size_t>(bytes) / sizeof(float));
  if (!stream.read(reinterpret_cast<char*>(data.data()), bytes)) {
    throw std::runtime_error("读取张量文件失败: " + path);
  }
  if (expected_count != 0 && data.size() != expected_count) {
    std::ostringstream message;
    message << "张量元素数量与模型输入不一致：文件 " << data.size() << "，模型输入 "
            << expected_count;
    throw std::runtime_error(message.str());
  }
  return data;
}

void save_raw_tensor(const std::string& path, const std::vector<float>& data) {
  std::ofstream stream(path, std::ios::binary);
  if (!stream) {
    throw std::runtime_error("无法写入张量文件: " + path);
  }
  stream.write(reinterpret_cast<const char*>(data.data()),
               static_cast<std::streamsize>(data.size() * sizeof(float)));
}

}  // namespace qforge
