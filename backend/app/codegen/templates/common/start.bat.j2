@echo off
rem QForge inference launcher (Windows) - generated by QForge
rem Keep this file ASCII-only with CRLF line endings (cmd.exe garbles UTF-8 text).
rem See README.md (Chinese) for details.
setlocal
cd /d "%~dp0"

set "BIN=bin\qforge_detector.exe"
set "ENGINE=model\model.engine"
set "IMAGE=test\sample.ppm"
set "OUTPUT=result.json"

echo ============================================================
echo  QForge inference  ({{ model.architecture }} / {{ precision_label }})
echo ============================================================
echo.

if not exist "%BIN%" goto no_bin
if not exist "%ENGINE%" goto no_engine

echo  engine : %ENGINE%
if exist "%IMAGE%" (echo  image  : %IMAGE%) else (echo  image  : ^(missing, see README.md^))
echo  output : %OUTPUT%
echo.

"%BIN%" --engine "%ENGINE%" --image "%IMAGE%" --output "%OUTPUT%" --iterations 5
set "CODE=%ERRORLEVEL%"

echo.
if not "%CODE%"=="0" goto failed
echo  Done. Result written to %OUTPUT%
echo.
pause
exit /b 0

:failed
echo  [FAILED] exit code %CODE%
echo  Common causes:
echo    1^) TensorRT / CUDA runtime DLLs not found - add TensorRT's bin folder to PATH
echo    2^) NVIDIA driver too old for this engine
echo    3^) GPU does not match the engine build environment
echo  See README.md for details.
echo.
pause
exit /b %CODE%

:no_bin
echo  [FAILED] bin\qforge_detector.exe not found.
echo  This package was built without the compiled binary, or you are on the wrong platform.
echo  Options: run start.sh on Linux, use docker\ (container), or rebuild from source\.
echo.
pause
exit /b 1

:no_engine
echo  [FAILED] model\model.engine not found.
echo  The engine is required to run inference. See README.md.
echo.
pause
exit /b 1
