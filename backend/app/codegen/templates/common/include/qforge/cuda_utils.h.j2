namespace qforge {

/// 显存缓冲区：析构自动释放，避免泄漏
class DeviceBuffer {
 public:
  DeviceBuffer() = default;
  DeviceBuffer(const DeviceBuffer&) = delete;
  DeviceBuffer& operator=(const DeviceBuffer&) = delete;

  // 可移动：TensorBinding 需要放进 std::vector
  DeviceBuffer(DeviceBuffer&& other) noexcept : ptr_(other.ptr_), bytes_(other.bytes_) {
    other.ptr_ = nullptr;
    other.bytes_ = 0;
  }

  DeviceBuffer& operator=(DeviceBuffer&& other) noexcept {
    if (this != &other) {
      reset();
      ptr_ = other.ptr_;
      bytes_ = other.bytes_;
      other.ptr_ = nullptr;
      other.bytes_ = 0;
    }
    return *this;
  }

  ~DeviceBuffer() { reset(); }

  void allocate(std::size_t bytes) {
    reset();
    bytes_ = bytes;
    QFORGE_CUDA_CHECK(cudaMalloc(&ptr_, bytes_));
  }

  void* data() { return ptr_; }
  const void* data() const { return ptr_; }
  std::size_t bytes() const { return bytes_; }

  void copy_from_host(const void* host, std::size_t bytes) {
    QFORGE_CUDA_CHECK(cudaMemcpy(ptr_, host, bytes, cudaMemcpyHostToDevice));
  }

  void copy_to_host(void* host, std::size_t bytes) const {
    QFORGE_CUDA_CHECK(cudaMemcpy(host, ptr_, bytes, cudaMemcpyDeviceToHost));
  }

  void reset() {
    if (ptr_ != nullptr) {
      cudaFree(ptr_);
      ptr_ = nullptr;
      bytes_ = 0;
    }
  }

 private:
  void* ptr_ = nullptr;
  std::size_t bytes_ = 0;
};

/// CUDA 流：析构自动销毁
class CudaStream {
 public:
  CudaStream() { QFORGE_CUDA_CHECK(cudaStreamCreate(&stream_)); }
  CudaStream(const CudaStream&) = delete;
  CudaStream& operator=(const CudaStream&) = delete;
  ~CudaStream() {
    if (stream_ != nullptr) {
      cudaStreamDestroy(stream_);
    }
  }

  cudaStream_t get() const { return stream_; }
  void synchronize() const { QFORGE_CUDA_CHECK(cudaStreamSynchronize(stream_)); }

 private:
  cudaStream_t stream_ = nullptr;
};

}  // namespace qforge
